# Generate with: openssl rand -base64 32
AUTH_SECRET=

# LINE Login channel. Never commit the real values.
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# Trust the request host on Vercel (preview URLs change).
AUTH_TRUST_HOST=true

# Test mode: every signed-in LINE account may open the board (the allowlist below is ignored).
# Set to false to enforce AUTH_LINE_ALLOWLIST again.
AUTH_TEST_MODE=true

# Comma-separated LINE user IDs (the id shown on the pending screen).
# Only used when AUTH_TEST_MODE=false. Leave empty to allow every signed-in LINE account.
AUTH_LINE_ALLOWLIST=

# Neon pooled connection string. Server only.
DATABASE_URL=

# Bank of Thailand API token (free, from https://portal.api.bot.or.th, Financial Institutions' Holidays).
# Server only. Without it only weekends and EXTRA_HOLIDAYS close the board.
BOT_API_TOKEN=

# Extra closures the API does not list: comma-separated dates, each optionally "=name".
# Example: 2026-12-30=ปิดปรับปรุงห้องผ่าตัด,2026-12-31
EXTRA_HOLIDAYS=

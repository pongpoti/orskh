# Copy to .env.local for local development. Never commit real values.
# Required in production (Vercel env)
# canonical origin, e.g. https://orskh.vercel.app (LINE callback = APP_URL/api/auth/line/callback)
APP_URL=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 32+ characters (openssl rand -base64 32); rotating it signs everyone out
SESSION_SECRET=
# 16+ characters: HMAC key for stored one-time codes
OTP_PEPPER=
# Postgres (Neon pooled connection string). Server only.
DATABASE_URL=
# Gmail account + app password that sends the sign-in codes
SMTP_USER=
SMTP_PASS=
# Optional
# break-glass list (comma-separated): these emails stay authorized without a database read (signing in still needs
# the database); the physician list is the table physicians
ALLOWED_EMAILS=
# Comma-separated LINE user IDs of the admins, who may open /admin and edit the surgeon list (the session's
# LINE user id; after signing in once: SELECT line_sub FROM line_bindings WHERE email = lower('you@example.com')).
# Unset or empty means there is no admin.
AUTH_ADMIN_LINE_IDS=
SMTP_HOST=
SMTP_PORT=
MAIL_FROM=
# sign-in alerts and access-request decisions (chat IDs comma-separated); off when either is unset.
# Use a bot of its own, not skh-or-schedule's: a bot has a single webhook and each app takes it over when it
# registers, so taps on one app's messages would reach the other. The same admins can press Start in both bots.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bank of Thailand API token (free, from https://portal.api.bot.or.th, Financial Institutions' Holidays).
# Server only. Without it only weekends and EXTRA_HOLIDAYS close the board.
BOT_API_TOKEN=
# Extra closures the API does not list: comma-separated dates, each optionally "=name".
# Example: 2026-12-30=ปิดปรับปรุงห้องผ่าตัด,2026-12-31
EXTRA_HOLIDAYS=
# Development / tests only (ignored when VERCEL is set)
LINE_AUTH_URL=
LINE_API_URL=
TELEGRAM_API_URL=
EMAIL_TRANSPORT=
EMAIL_OUTBOX_DIR=

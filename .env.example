# Copy to .env.local for local development. Never commit real values.
# Required in production (Vercel env)
# canonical origin, e.g. https://orskh.vercel.app (LINE callback = APP_URL/api/auth/line/callback)
APP_URL=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 32+ characters (openssl rand -base64 32); rotating it signs everyone out
SESSION_SECRET=
# 16+ characters: HMAC key for stored one-time codes
OTP_PEPPER=
# Postgres (Neon pooled connection string). Server only.
DATABASE_URL=
# deeSMSX (https://deesmsx.com) sends and checks the sign-in codes by SMS: keys from the API settings in my.deesmsx.com
DEESMSX_API_KEY=
DEESMSX_SECRET_KEY=
# Needed for name claims: Telegram bot and chats.
# sign-in alerts, access-request decisions and name claims with their undo button (chat IDs comma-separated); off
# when either is unset. Name claims need both and at least one numeric (person) chat ID; without that, everyone goes
# through access requests.
# Use a bot of its own, not skh-or-schedule's: a bot has a single webhook and each app takes it over when it
# registers, so taps on one app's messages would reach the other. The same admins can press Start in both bots.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional
# break-glass list (Thai mobile numbers, comma-separated, e.g. 0812345678 or 081-234-5678): these stay authorized
# without a database read (signing in still needs the database); everyone else claims a name from the table users
# (shared with the rest of the project; the sign-in only reads it, claims go to user_claims) or is approved
ALLOWED_PHONES=
# Comma-separated LINE user IDs of the admins, who may open /admin and edit the surgeon list (the session's
# LINE user id; after signing in once: SELECT line_sub FROM line_bindings WHERE phone = '0812345678').
# Unset or empty means there is no admin.
AUTH_ADMIN_LINE_IDS=
# SMS sender name: default deeSMS.OTP (deeSMSX's shared OTP sender); set to your own name (e.g. ORSKH) once deeSMSX
# has approved it
DEESMSX_SENDER=
# at most this many codes are sent in any 24 hours, for everyone together (default 300); then sending stops with
# "ระบบส่ง SMS ครบจำนวนของวันนี้แล้ว" and Telegram is told
SMS_DAILY_CAP=
# Bank of Thailand API token (free, from https://portal.api.bot.or.th, Financial Institutions' Holidays).
# Server only. Without it only weekends and EXTRA_HOLIDAYS close the board.
BOT_API_TOKEN=
# Extra closures the API does not list: comma-separated dates, each optionally "=name".
# Example: 2026-12-30=ปิดปรับปรุงห้องผ่าตัด,2026-12-31
EXTRA_HOLIDAYS=
# Development / tests only (ignored when VERCEL is set)
LINE_AUTH_URL=
LINE_API_URL=
TELEGRAM_API_URL=
# deesmsx (default) | console (code printed in the log) | file (one JSON file per SMS in SMS_OUTBOX_DIR);
# console and file make the code locally and never reach deeSMSX
SMS_PROVIDER=
SMS_OUTBOX_DIR=
# the mock deeSMSX server (tests/mock-deesmsx.mjs), e.g. http://localhost:4011/v1
DEESMSX_API_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# LINE Login channel. Never commit the real values.
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# Trust the request host on Vercel (preview URLs change).
AUTH_TRUST_HOST=true

# Test mode: every signed-in LINE account may open the board (the allowlist below is ignored).
# Set to false to enforce AUTH_LINE_ALLOWLIST again.
AUTH_TEST_MODE=true

# Comma-separated LINE user IDs (the id shown on the pending screen).
# Only used when AUTH_TEST_MODE=false. Leave empty to allow every signed-in LINE account.
AUTH_LINE_ALLOWLIST=

# Neon pooled connection string. Server only.
DATABASE_URL=
